# Docker image deployed by GitHub Actions.
BACKEND_IMAGE=ghcr.io/kocotree/kocotree-skills-desktop-backend
BACKEND_IMAGE_TAG=latest

# Fastify runtime.
PORT=4000
HOST=0.0.0.0
FRONTEND_ORIGINS=tauri://localhost,http://tauri.localhost

# Existing PostgreSQL cloud database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/skill_platform

# Feishu desktop OAuth.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace-with-feishu-app-secret
FEISHU_REDIRECT_URI=https://skills-api.kktree.cn/api/auth/feishu/callback
TOKEN_SECRET=replace-with-a-long-random-secret
DESKTOP_AUTH_CALLBACK_URL=kocotree-skills://auth/callback
OAUTH_STATE_TTL_SECONDS=300
DESKTOP_AUTH_CODE_TTL_SECONDS=300
DESKTOP_TOKEN_TTL_SECONDS=2592000

# Existing Aliyun OSS bucket.
STORAGE_DRIVER=aliyun-oss
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=kocotree-skill-storage
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-with-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-access-key-secret
OSS_SIGNED_URL_EXPIRES_SECONDS=300
SKILL_PREVIEW_TEXT_MAX_KB=1024
SKILL_UPLOAD_MAX_MB=50

# DeepSeek Skill 中文展示信息翻译（仅后端可见）。
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_TRANSLATION_MODEL=deepseek-v4-flash
DEEPSEEK_TRANSLATION_TIMEOUT_MS=8000
