DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/skill_platform"
PORT="4000"
HOST="0.0.0.0"
FRONTEND_ORIGINS="http://localhost:1420,tauri://localhost,http://tauri.localhost"

FEISHU_APP_ID="cli_xxx"
FEISHU_APP_SECRET="xxx"
FEISHU_REDIRECT_URI="http://localhost:4000/api/auth/feishu/callback"

TOKEN_SECRET="replace-with-a-long-random-secret"
DESKTOP_AUTH_CALLBACK_URL="kocotree-skills://auth/callback"
OAUTH_STATE_TTL_SECONDS="600"
DESKTOP_AUTH_CODE_TTL_SECONDS="120"
DESKTOP_TOKEN_TTL_SECONDS="15552000"

STORAGE_DRIVER="aliyun-oss"
