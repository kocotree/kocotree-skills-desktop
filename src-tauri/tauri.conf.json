{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kocotree Skills",
  "version": "0.2.3",
  "identifier": "cn.kocotree.skills.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev:lan",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kocotree Skills",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kocotree-skills"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFNjBFMTBCMzI4QUVCRjEKUldUeDY0b3lDK0ZnZm16eFYzM0NpSFVDWHoyOUY0UGJQaERhR1VNQjkyQjlZYjRUeWVNMUcrUmoK",
      "endpoints": [
        "https://github.com/kocotree/kocotree-skills-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
